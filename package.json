{
	"name": "gymrat-drizzle",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite preview",
		"deploy": "vite build && wrangler deploy",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint -c .oxlintrc.json --type-aware --type-check --deny-warnings",
		"lint:fix": "oxlint -c .oxlintrc.json --type-aware --type-check --fix",
		"test": "vitest run",
		"generate:migration": "drizzle-kit generate --config=drizzle-kit.config.ts",
		"run:migration": "wrangler d1 execute gymrat --file",
		"studio": "drizzle-kit studio --config=drizzle-kit.config.ts"
	},
	"dependencies": {
		"@headlessui/react": "^2.2.10",
		"@heroicons/react": "^2.2.0",
		"@paper-design/shaders-react": "^0.0.76",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.169.4",
		"bcryptjs": "^3.0.3",
		"date-fns": "^4.4.0",
		"drizzle-orm": "1.0.0-rc.4",
		"framer-motion": "^12.43.0",
		"fuse.js": "^7.5.0",
		"iron-session": "^8.0.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"usehooks-ts": "^3.1.1",
		"worker-mailer": "latest",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.65.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcryptjs": "^3.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "1.0.0-rc.4",
		"oxfmt": "^0.57.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^0.24.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"wrangler": "^4.152.0"
	}
}
