{
	"name": "gymrat-drizzle",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vinext dev",
		"build": "vite build",
		"start": "vinext start",
		"deploy": "vite build && wrangler deploy",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint -c .oxlintrc.json --type-aware --type-check --deny-warnings",
		"lint:fix": "oxlint -c .oxlintrc.json --type-aware --type-check --fix",
		"test": "vitest run",
		"generate:migration": "drizzle-kit generate --config=drizzle-kit.config.ts",
		"run:migration": "wrangler d1 execute gymrat --file",
		"studio": "drizzle-kit studio --config=drizzle-kit.config.ts"
	},
	"dependencies": {
		"@headlessui/react": "^2.2.10",
		"@heroicons/react": "^2.2.0",
		"@hono/zod-validator": "^0.8.0",
		"@tanstack/react-query": "^5.101.2",
		"bcryptjs": "^3.0.3",
		"date-fns": "^4.4.0",
		"downshift": "^9.4.0",
		"drizzle-orm": "1.0.0-rc.4",
		"framer-motion": "^12.42.2",
		"fuse.js": "^7.4.2",
		"hono": "^4.12.27",
		"iron-session": "^8.0.4",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwind-merge": "^3.6.0",
		"usehooks-ts": "^3.1.1",
		"vinext": "^0.2.0",
		"worker-mailer": "latest",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.42.4",
		"@tailwindcss/vite": "^4.3.2",
		"@types/bcryptjs": "^3.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"drizzle-kit": "1.0.0-rc.4",
		"next": "^16.2.10",
		"oxfmt": "^0.57.0",
		"oxlint": "^1.72.0",
		"oxlint-tsgolint": "^0.24.0",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.1.3",
		"vitest": "^4.1.9",
		"wrangler": "^4.106.0"
	}
}
